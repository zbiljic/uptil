#!/bin/sh

set -eu

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(dirname "$script_directory")
reason="UpTil keep-awake session"

print_pid_report() {
    report=$1
    target_pid=$2

    relevant=$(printf '%s\n' "$report" | awk -v target="$target_pid" '
        /^Listed by owning process:/ { listed = 1; next }
        /^Kernel Assertions:/ { listed = 0 }
        listed && $0 ~ "^[[:space:]]*pid " target "\\(" { print }
    ')

    if test -n "$relevant"; then
        printf '%s\n' "$relevant" >&2
    else
        printf 'No owning-process entries found for pid %s.\n' "$target_pid" >&2
    fi
}

matching_assertion_count() {
    report=$1
    target_pid=$2

    printf '%s\n' "$report" | awk -v target="$target_pid" -v reason="$reason" '
        /^Listed by owning process:/ { listed = 1; next }
        /^Kernel Assertions:/ { listed = 0 }
        listed && $0 ~ "^[[:space:]]*pid " target "\\(" &&
            index($0, "PreventUserIdleSystemSleep") &&
            index($0, "UpTil") && index($0, reason) { count++ }
        END { print count + 0 }
    '
}

broader_assertion_count() {
    report=$1
    target_pid=$2

    printf '%s\n' "$report" | awk -v target="$target_pid" '
        /^Listed by owning process:/ { listed = 1; next }
        /^Kernel Assertions:/ { listed = 0 }
        listed && $0 ~ "^[[:space:]]*pid " target "\\(" &&
            (index($0, "PreventUserIdleDisplaySleep") ||
             index($0, "PreventSystemSleep")) { count++ }
        END { print count + 0 }
    '
}

named_assertion_count() {
    report=$1
    target_pid=$2

    printf '%s\n' "$report" | awk -v target="$target_pid" -v reason="$reason" '
        /^Listed by owning process:/ { listed = 1; next }
        /^Kernel Assertions:/ { listed = 0 }
        listed && $0 ~ "^[[:space:]]*pid " target "\\(" &&
            index($0, reason) { count++ }
        END { print count + 0 }
    '
}

printf '%s\n' "WARNING: This check replaces any running process named UpTil."
printf 'Continue? Type y to build and launch UpTil: '
IFS= read -r answer
if test "$answer" != "y"; then
    echo "Cancelled; UpTil was not changed."
    exit 0
fi

"$project_root/scripts/run"

attempt=0
pids=
while test "$attempt" -lt 20; do
    pids=$(pgrep -x UpTil 2>/dev/null || true)
    pid_count=$(printf '%s\n' "$pids" | awk 'NF { count++ } END { print count + 0 }')
    if test "$pid_count" -eq 1; then
        break
    fi
    if test "$pid_count" -gt 1; then
        printf 'Expected exactly one UpTil process; found PIDs:\n%s\n' "$pids" >&2
        exit 1
    fi
    attempt=$((attempt + 1))
    sleep 1
done

if test -z "$pids"; then
    echo "UpTil did not launch within 20 seconds." >&2
    exit 1
fi

pid=$pids
printf 'Using UpTil pid %s.\n' "$pid"

before_report=$(pmset -g assertions)
if test "$(named_assertion_count "$before_report" "$pid")" -ne 0; then
    echo "Expected no UpTil keep-awake assertion before starting a session." >&2
    print_pid_report "$before_report" "$pid"
    exit 1
fi

printf '%s\n' "In the UpTil menu, select 15m, then return here."
printf 'Press Return after the 15m session is active: '
IFS= read -r ignored

active_report=$(pmset -g assertions)
matching_count=$(matching_assertion_count "$active_report" "$pid")
broader_count=$(broader_assertion_count "$active_report" "$pid")
if test "$matching_count" -ne 1; then
    printf 'Expected exactly one idle-system-sleep assertion for pid %s; found %s.\n' \
        "$pid" "$matching_count" >&2
    print_pid_report "$active_report" "$pid"
    exit 1
fi
if test "$broader_count" -ne 0; then
    echo "UpTil unexpectedly owns a display-sleep or broad system-sleep assertion." >&2
    print_pid_report "$active_report" "$pid"
    exit 1
fi

printf '%s\n' "In the UpTil menu, select Stop, then return here."
printf 'Press Return after the session has stopped: '
IFS= read -r ignored

current_pids=$(pgrep -x UpTil 2>/dev/null || true)
current_pid_count=$(printf '%s\n' "$current_pids" | awk 'NF { count++ } END { print count + 0 }')
if test "$current_pid_count" -ne 1 || test "$current_pids" != "$pid"; then
    printf 'Expected the same UpTil process (%s) to remain running; found PIDs:\n%s\n' \
        "$pid" "${current_pids:-none}" >&2
    exit 1
fi

stopped_report=$(pmset -g assertions)
if test "$(named_assertion_count "$stopped_report" "$pid")" -ne 0; then
    echo "Expected the UpTil keep-awake assertion to be absent after Stop." >&2
    print_pid_report "$stopped_report" "$pid"
    exit 1
fi

echo "PASS: idle system sleep is prevented only while active; display sleep is not prevented."
